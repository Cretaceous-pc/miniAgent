# 复制成 .env 后填自己的 key。这个文件可以提交，.env 不要提交。
# 任何 OpenAI-compatible 服务都行：DeepSeek / 智谱 GLM / 阿里 Qwen / 本地 Ollama

MINIAGENT_API_KEY=
MINIAGENT_BASE_URL=https://api.deepseek.com/v1
MINIAGENT_MODEL=deepseek-chat
# 想看"思考路径"就换成 deepseek-reasoner（支持工具调用，CLI 会打印 💭 行）
# MINIAGENT_MODEL=deepseek-reasoner

# 可选：上下文预算与轮次
# MINIAGENT_CONTEXT_WINDOW=32768
# MINIAGENT_BUDGET_RATIO=0.6
# MINIAGENT_MAX_ROUNDS=8
# MINIAGENT_KEEP_RECENT=10
# MINIAGENT_DATA_DIR=.miniagent
